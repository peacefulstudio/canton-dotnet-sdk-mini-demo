<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Daml C# runtime + ledger abstractions (the surface the generated bindings compile against). -->
    <PackageVersion Include="Daml.Runtime" Version="0.6.0-preview.3" />
    <PackageVersion Include="Daml.Ledger.Abstractions" Version="0.6.0-preview.3" />
    <PackageVersion Include="Splice.Api.Token.Holding.V2" Version="1.0.0.15-preview.3" />
    <PackageVersion Include="Splice.Api.Token.Transfer.Instruction.V2" Version="1.0.0.15-preview.3" />
    <!-- Canton gRPC Ledger API SDK + transport-neutral client kernel (auth/retry/telemetry). -->
    <PackageVersion Include="Canton.Ledger.Grpc.Client" Version="0.6.0-preview.3" />
    <PackageVersion Include="Canton.Ledger.Rest.Client" Version="0.6.0-preview.3" />
    <PackageVersion Include="Canton.Ledger.Kernel" Version="0.6.0-preview.3" />
    <PackageVersion Include="Canton.Ledger.Pqs.Client" Version="0.6.0-preview.3" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- LocalNet bootstrap helper: uploads the DAR, allocates parties, mints a token via env discovery. -->
    <PackageVersion Include="Peaceful.Canton.Localnet.Testing" Version="0.8.4.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
  </ItemGroup>
</Project>
