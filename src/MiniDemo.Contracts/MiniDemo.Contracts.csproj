<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MiniDemo.Asset</RootNamespace>
    <AssemblyName>MiniDemo.Contracts</AssemblyName>
    <Description>Generated DAML contract bindings for the Canton .NET SDK mini demo.</Description>
    <!-- Generated XML-doc crefs reference extension methods that don't resolve via cref syntax. -->
    <NoWarn>$(NoWarn);CS1574</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <DamlNamespace>MiniDemo.Asset</DamlNamespace>
  </PropertyGroup>

  <ItemGroup>
    <DamlProject Include="../../daml" />
  </ItemGroup>

  <Target Name="CopyDamlArchiveToOutput" AfterTargets="DamlBuildProject" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <Content Include="$(_DamlProjectDar)" Link="$([System.IO.Path]::GetFileName('$(_DamlProjectDar)'))" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Daml.Codegen.CSharp.MSBuild" PrivateAssets="all" />
    <PackageReference Include="Daml.Runtime" />
    <PackageReference Include="Daml.Ledger.Abstractions" />
    <PackageReference Include="Splice.Api.Token.Holding.V2" />
    <PackageReference Include="Splice.Api.Token.Transfer.Instruction.V2" />
  </ItemGroup>
</Project>
